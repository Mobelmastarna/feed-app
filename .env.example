# Port/host appen lyssnar på lokalt (Caddy proxar app.mobelmastarna.se/feed
# hit). HOST ska vara 127.0.0.1 i produktion - appen ska aldrig nås direkt
# utifrån, bara via Caddy på samma maskin.
PORT=3020
HOST=127.0.0.1

# Inloggning till /feed/admin (HTTP Basic Auth - enda inloggningen appen har,
# helt fristående från CRM:ets Supabase Auth). Lösenordet lagras som en
# bcrypt-hash, aldrig i klartext. Generera med:
#   node scripts/hash-password.js "mitt-starka-lösenord"
FEED_ADMIN_USER=admin
FEED_ADMIN_PASSWORD_HASH=byt-ut-mot-hashen-fran-scripts/hash-password.js

# Var lokala data (config.json, senaste CSV, körningshistorik) sparas.
# Standard: ./data relativt appens mapp.
DATA_DIR=./data

# Produktfeed till OpenAI Ads - SFTP-uppgifter från
# ads.openai.com -> Flöden -> Anslut ditt flöde via SFTP.
OPENAI_FEED_SFTP_HOST=sftp.commerce.openai.com
OPENAI_FEED_SFTP_PORT=443
OPENAI_FEED_SFTP_USERNAME=oaiproductfeedprod.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_FEED_SFTP_REMOTE_PATH=/

# SFTP-autentisering: ANTINGEN SSH-nyckel ELLER lösenord (inte båda).
#
# SSH-nyckel: Sökväg till den privata SSH-nyckelfilen (matchande publik nyckel
# inlagd i OpenAIs SFTP-ruta). Filen ska ha rättigheter 600, ägas av samma
# användare som kör appen, och INTE ligga i git.
OPENAI_FEED_SFTP_PRIVATE_KEY_PATH=/home/feedapp/feed-app/openai_feed_sftp
#
# ELLER lösenord: Om du använder lösenord istället för SSH-nyckel, sätt detta
# och lämna OPENAI_FEED_SFTP_PRIVATE_KEY_PATH tom eller kommenterad.
# OPENAI_FEED_SFTP_PASSWORD=ditt-sftp-lösenord
